{
    "name": "omnistate/matchid",
    "type": "library",
    "description": "Omnistate matchID: France's deaths since 1970 (INSEE's file of deceased persons) searched through deces.matchid.io - names, birth, death, the act's number.",
    "keywords": [
        "genealogy",
        "civil registry",
        "etat civil",
        "deces",
        "insee",
        "matchid",
        "france",
        "omnistate"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnistate": "^1.0@dev",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Omnistate\\MatchId\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnistate\\MatchId\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
